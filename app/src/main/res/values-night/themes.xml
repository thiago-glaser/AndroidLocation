<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LocationService" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand / Primary colors for Dark Mode -->
        <item name="colorPrimary">#818CF8</item>
        <item name="colorOnPrimary">#1E1B4B</item>
        <item name="colorPrimaryContainer">#312E81</item>
        <item name="colorOnPrimaryContainer">#E0E7FF</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorOnSecondary">#082F49</item>
        <item name="colorSecondaryContainer">#0369A1</item>
        <item name="colorOnSecondaryContainer">#E0F2FE</item>

        <!-- Tertiary colors -->
        <item name="colorTertiary">#34D399</item>
        <item name="colorOnTertiary">#064E3B</item>
        <item name="colorTertiaryContainer">#065F46</item>
        <item name="colorOnTertiaryContainer">#D1FAE5</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">#0F172A</item>
        <item name="colorOnBackground">#F8FAFC</item>
        <item name="colorSurface">#1E293B</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#334155</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorOutline">#475569</item>
        <item name="colorOutlineVariant">#334155</item>

        <!-- System bars -->
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1E293B</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColor">#F8FAFC</item>
        <item name="android:spinnerDropDownItemStyle">@style/LocationService.SpinnerDropDownItem</item>
    </style>

    <style name="LocationService.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">#F8FAFC</item>
    </style>

</resources>


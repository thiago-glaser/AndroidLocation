<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LocationService" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand / Primary colors for Dark Mode -->
        <item name="colorPrimary">#818CF8</item>
        <item name="colorOnPrimary">#1E1B4B</item>
        <item name="colorPrimaryContainer">#312E81</item>
        <item name="colorOnPrimaryContainer">#E0E7FF</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorOnSecondary">#082F49</item>
        <item name="colorSecondaryContainer">#0369A1</item>
        <item name="colorOnSecondaryContainer">#E0F2FE</item>

        <!-- Tertiary colors -->
        <item name="colorTertiary">#34D399</item>
        <item name="colorOnTertiary">#064E3B</item>
        <item name="colorTertiaryContainer">#065F46</item>
        <item name="colorOnTertiaryContainer">#D1FAE5</item>

        <!-- Background & Surface (Pure Black for Dark Mode) -->
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_outline</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- System bars (Pure Black) -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColor">@color/text_primary</item>
        <item name="android:spinnerDropDownItemStyle">@style/LocationService.SpinnerDropDownItem</item>
    </style>

    <style name="LocationService.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/surface_card</item>
    </style>

</resources>

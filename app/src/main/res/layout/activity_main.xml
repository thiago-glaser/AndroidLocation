<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8FAFC">

    <!-- Main Page: Dashboard with native feature navigation and settings -->
    <ScrollView
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="Location Icon"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location Services"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvMainSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background tracker is active"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp" />

            <!-- Feature Navigation Grid / Buttons -->
            <Button
                android:id="@+id/btnNavSessions"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="🚗  Trips &amp; Sessions"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNavCars"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="🚘  Manage Cars"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNavBluetooth"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="📶  Bluetooth Devices"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNavFuel"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="⛽  Fuel Logs"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNavExpenses"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="💳  Vehicle Expenses"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#0D9488"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNavReports"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="📊  Reports &amp; Analytics"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#D97706"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp" />

            <!-- Settings Button -->
            <Button
                android:id="@+id/btnToggleSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:maxWidth="340dp"
                android:text="⚙  Settings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Settings Screen: Keep service controls and configuration working -->
    <ScrollView
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Settings Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnHideSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Settings"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />
            </LinearLayout>

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Status"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Service stopped"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Key"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvApiKeyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Checking API key..."
                    android:textSize="14sp"
                    android:textColor="#334155" />
            </LinearLayout>

            <!-- Actions -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Start Location Logging"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Stop Logging"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnUpdateApiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update API Key"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnReturnMain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Back to Main Page"
                android:textSize="14sp"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#64748B" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
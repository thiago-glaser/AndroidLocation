<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Main Page: Dashboard with native feature navigation and settings -->
    <ScrollView
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="Location Icon"
                app:tint="?attr/colorPrimary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_header_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvMainSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background tracker is active"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp" />

            <!-- Active Session Status + Quick Start / End Session Button -->
            <TextView
                android:id="@+id/tvActiveSessionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartEndSession"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_start_session"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Feature Navigation Grid / Material Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavSessions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_trips"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavCars"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_cars"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavBluetooth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_bluetooth"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavFuel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_fuel"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavExpenses"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_expenses"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#0D9488"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavReports"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_reports"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#D97706"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="20dp" />

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="@string/main_btn_settings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Settings Screen: Keep service controls and configuration working -->
    <ScrollView
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Settings Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnHideSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Back"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/settings_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Status Card: MaterialCardView -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurface"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_service_status"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/main_status_service_stopped"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_api_key"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvApiKeyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_api_key_checking"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />
                                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_account"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvAccountUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_account_not_logged_in"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_unit_system"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvUnitSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_unit_metric"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_tracking_mode"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvTrackingMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_tracking_session_only"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_label_language"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lang_system_default"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_start"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_stop"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeTrackingMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_change_tracking_mode"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeUnits"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_change_units"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_change_language"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#0D9488"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateApiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_update_api_key"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenLogcat"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_logcat"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#1E293B"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCleanLocationData"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_clean_location"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#B91C1C"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/main_btn_logout"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#EF4444"
                android:textColor="#EF4444"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnMain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/main_btn_back"
                android:textSize="14sp"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TextButton"
                app:cornerRadius="14dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>

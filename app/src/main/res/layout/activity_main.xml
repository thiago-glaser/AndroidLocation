<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Main Page: Dashboard with native feature navigation and settings -->
    <ScrollView
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="Location Icon"
                app:tint="?attr/colorPrimary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location Services"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvMainSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background tracker is active"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp" />

            <!-- Feature Navigation Grid / Material Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavSessions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="🚗  Trips &amp; Sessions"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavCars"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="🚘  Manage Cars"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavBluetooth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="📶  Bluetooth Devices"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavFuel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="⛽  Fuel Logs"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavExpenses"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="💳  Vehicle Expenses"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#0D9488"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavReports"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:maxWidth="340dp"
                android:text="📊  Reports &amp; Analytics"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#D97706"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="20dp" />

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:maxWidth="340dp"
                android:text="⚙  Settings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                app:cornerRadius="16dp"
                app:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                app:elevation="2dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Settings Screen: Keep service controls and configuration working -->
    <ScrollView
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Settings Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/btnHideSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Back"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Settings"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Status Card: MaterialCardView -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurface"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Status"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Service stopped"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API Key"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvApiKeyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Checking API key..."
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />
                                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvAccountUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Not logged in"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Start Location Logging"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Stop Logging"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateApiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update API Key"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                app:elevation="1dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Log Out"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#EF4444"
                android:textColor="#EF4444"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReturnMain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Back to Main Page"
                android:textSize="14sp"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TextButton"
                app:cornerRadius="14dp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LocationService" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand / Primary colors -->
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#EEF2FF</item>
        <item name="colorOnPrimaryContainer">#312E81</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">#0284C7</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E0F2FE</item>
        <item name="colorOnSecondaryContainer">#075985</item>

        <!-- Tertiary colors -->
        <item name="colorTertiary">#059669</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#D1FAE5</item>
        <item name="colorOnTertiaryContainer">#064E3B</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_outline</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:textColor">@color/text_primary</item>
        <item name="android:spinnerDropDownItemStyle">@style/LocationService.SpinnerDropDownItem</item>
    </style>

    <style name="LocationService.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/surface_card</item>
    </style>

</resources>
